<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Test project: no public API surface, so no XML documentation file is generated.
         IDE0005 cannot run on build without doc generation (roslyn#41640), so it is suppressed here. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Bosak.XPath.Providers" Version="1.81.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../minimum/schema/SchemaCandidate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TestData\Schemas\sku.xsd" CopyToOutputDirectory="PreserveNewest" Link="TestData\Schemas\sku.xsd" />
    <None Include="..\TestData\Schemas\orders.xsd" CopyToOutputDirectory="PreserveNewest" Link="TestData\Schemas\orders.xsd" />
    <None Include="..\TestData\Schemas\native-decimal.*" CopyToOutputDirectory="PreserveNewest" Link="TestData\Schemas\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../TestData/NodeData/*.json" CopyToOutputDirectory="PreserveNewest" Link="TestData/NodeData/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><None Include="../TestData/ComplexSimpleRestriction/*.json" CopyToOutputDirectory="PreserveNewest" Link="TestData/ComplexSimpleRestriction/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><None Include="../TestData/IntegerSimpleContent/*.json" CopyToOutputDirectory="PreserveNewest" Link="TestData/IntegerSimpleContent/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><None Include="../TestData/ContextualAssertions/*.json" CopyToOutputDirectory="PreserveNewest" Link="TestData/ContextualAssertions/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup>
    <None Include="../TestData/StructuralAssertions/*.json" CopyToOutputDirectory="PreserveNewest" Link="TestData/StructuralAssertions/%(Filename)%(Extension)" />
    <None Include="../TestData/ConformancePilot/upstream/ibmData/mixed/assertions/namespace/ns3.xsd" CopyToOutputDirectory="PreserveNewest" Link="original-ns3.xsd" />
    <None Include="../TestData/ConformancePilot/upstream/ibmData/mixed/assertions/namespace/ns3.xml" CopyToOutputDirectory="PreserveNewest" Link="original-ns3.xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../TestData/StringPatterns/**/*" CopyToOutputDirectory="PreserveNewest" Link="TestData/StringPatterns/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><None Include="../TestData/SimpleRoots/**/*" CopyToOutputDirectory="PreserveNewest" Link="TestData/SimpleRoots/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><None Include="../TestData/DerivedIntegers/**/*" CopyToOutputDirectory="PreserveNewest" Link="TestData/DerivedIntegers/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><None Include="../TestData/Particles/*" CopyToOutputDirectory="Always" Link="%(Filename)%(Extension)" /></ItemGroup>
</Project>
