root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

# .NET style rules
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

# Analyzer severities
dotnet_diagnostic.IDE0005.severity = warning    # Unused usings
dotnet_diagnostic.IDE0090.severity = warning    # Simplify 'new' expression
dotnet_diagnostic.IDE0161.severity = warning    # File-scoped namespaces
dotnet_diagnostic.CA1822.severity = suggestion  # Mark members static
